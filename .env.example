# dsh-immune-system environment configuration template
# Zero-config works out of the box using local Node.js built-in sqlite + deterministic rule distillation.
# Copy or set these variables only when enabling optional features.

# ---------------------------------------------------------------------------
# 1. Optional LLM Distillation / Self-Reflection Critique / Rewrite
# ---------------------------------------------------------------------------
# Option A: OpenAI-compatible Cloud Endpoint (private IPs blocked unless loopback preset is used)
IMMUNE_LLM_BASE_URL=
IMMUNE_LLM_MODEL=
IMMUNE_LLM_API_KEY=

# Option B: Local Ollama Server (loopback auto-allowed: http://127.0.0.1:11434/v1)
# IMMUNE_OLLAMA_MODEL=qwen2.5-coder:7b

# Option C: Local Magpie Multi-Model Gateway (loopback auto-allowed: http://127.0.0.1:3425/v1)
# IMMUNE_MAGPIE_MODEL=deepseek-v4.1-flash
# IMMUNE_MAGPIE_API_KEY=

# Turn-end Stop / agent-turn-stopping distillation time budget in ms (clamped to 1000..60000)
IMMUNE_DISTILL_BUDGET_MS=12000

# ---------------------------------------------------------------------------
# 2. Storage, Scope & Sharing
# ---------------------------------------------------------------------------
# Override default project database path (otherwise host data dir or <repo>/.dsh/immune.sqlite)
# IMMUNE_DB_PATH=

# Set to 0 to disable cross-project shared library promotion (~/.dsh-immune/shared.sqlite)
# IMMUNE_GLOBAL_LIBRARY=1

# ---------------------------------------------------------------------------
# 3. Runtime Guards, Sync & Display
# ---------------------------------------------------------------------------
# PreToolUse destructive-command guard: off (default) | warn (ZCode only) | deny
IMMUNE_GUARD=off

# Auto-sync proven rules into project docs at turn end (AGENTS.md / CLAUDE.md / 1 for auto)
# IMMUNE_SYNC_DOC=AGENTS.md
# IMMUNE_SYNC_DOC_MIN_HITS=3

# Set to off to disable proactive workspace stack pre-warming on SessionStart
# IMMUNE_PREWARM=on

# Override model attribution name when host payload does not report model_usage
# IMMUNE_MODEL_NAME=

# Dashboard & CLI locale override: zh-CN | en
# IMMUNE_LOCALE=zh-CN
