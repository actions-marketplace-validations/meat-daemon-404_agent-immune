{
  "name": "dsh-immune-system",
  "version": "2.3.0",
  "private": false,
  "description": "Self-evolving pitfall immunity engine, MCP server, and programmatic Node.js/TypeScript SDK for coding agents (Claude Code, Cursor, Codex, Windsurf, Cline, Zed, Copilot, Continue, Goose, Roo Code, Kiro, Gemini CLI, Aider, OpenCode, Antigravity, ZCode, DSH). Automatically learns from tool failures and prevents repeat bugs locally with SQLite + FTS5.",
  "type": "module",
  "main": "./dsh-immune-system/dist/dsh/src/index.js",
  "types": "./dsh-immune-system/dist/dsh/src/index.d.ts",
  "bin": {
    "dsh-immune-system": "dsh-immune-system/dist/zcode/src/cli.js",
    "immune": "dsh-immune-system/dist/zcode/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dsh-immune-system/dist/dsh/src/index.d.ts",
      "default": "./dsh-immune-system/dist/dsh/src/index.js"
    },
    "./core": {
      "types": "./dsh-immune-system/dist/core/index.d.ts",
      "default": "./dsh-immune-system/dist/core/index.js"
    },
    "./client": "./dsh-immune-system/dist/dsh/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-immune-system/dist/",
    "dsh-immune-system/cordis.patch.yml",
    "dsh-immune-system/.zcode-plugin/",
    "dsh-immune-system/skills/",
    ".claude-plugin/",
    "server.json",
    "smithery.yaml",
    "glama.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "id": "dsh-immune-system",
    "name": "Immune System",
    "version": "2.3.0",
    "description": "Turns recurring agent failures into short reminders injected on matching future tasks.",
    "bundle": {
      "patch": "./dsh-immune-system/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react",
        "module-registry",
        "workspace",
        "layout",
        "sidebar-tools",
        "app-rail"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node scripts/check-versions.mjs && node scripts/verify-dist-integrity.mjs",
    "bench": "node scripts/bench-recall.mjs && node scripts/bench-seed-recall.mjs && node scripts/bench-ab-simulation.mjs && node scripts/bench-scale.mjs",
    "bench:ab": "node scripts/bench-ab-simulation.mjs",
    "verify": "npm run build && npm run check && npm test && node scripts/bench-recall.mjs && node scripts/bench-seed-recall.mjs && node scripts/bench-ab-simulation.mjs && node scripts/verify-connected-runtime.mjs"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "claude-plugin",
    "cursor",
    "codex",
    "windsurf",
    "cline",
    "zed",
    "github-copilot",
    "continue-dev",
    "goose",
    "roo-code",
    "kiro",
    "gemini-cli",
    "aider",
    "opencode",
    "antigravity",
    "self-evolving",
    "agent-memory",
    "reflexion",
    "sqlite",
    "fts5",
    "developer-tools"
  ],
  "author": "meat-daemon-404",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meat-daemon-404/agent-immune.git"
  },
  "homepage": "https://github.com/meat-daemon-404/agent-immune#readme",
  "bugs": {
    "url": "https://github.com/meat-daemon-404/agent-immune/issues"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
